# Copy to .env (or export these directly) and fill in as needed.
# Defaults below match the $0-cost local setup — nothing here is required
# to run the project locally with a local PostgreSQL install.

# --- Database (local Postgres, see docs/testing.md / README setup) ---
DB_URL=jdbc:postgresql://localhost:5432/healthcare
DB_USERNAME=healthcare
DB_PASSWORD=healthcare

# --- Ingestion ---
# Path to the directory containing the 5 feed CSVs (patients.csv, encounters.csv, ...)
FEEDS_DIR=../data/generated
# Probability (0.0-1.0) each ingestion attempt is randomly injected with a simulated failure.
FAILURE_RATE=0.0
MAX_RETRIES=3
INITIAL_BACKOFF_MS=2000
BACKOFF_MULTIPLIER=2

# --- Raw landing zone (local filesystem stands in for Azure Blob Storage) ---
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=./local-storage/raw

# --- Azure (OPTIONAL — only used if STORAGE_PROVIDER=azure; never required) ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=healthcare-raw

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Server ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local